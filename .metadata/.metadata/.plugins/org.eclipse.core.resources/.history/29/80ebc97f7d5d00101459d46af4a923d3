#include "LCD_SPI.h"

SPI_Handle_t spi;

void LCD_SPI_Config(){
	spi.pSPIx = SPI1;
	spi.SPI_Congif_t.MaxCLK = 15000000;
	SPI_Init(&spi);
}

void LCDSPI_send_cmd(uint8_t data){
	SPI_Transmit(&spi, data); // Software reset
}

void Init_LCD_SPI(){
	LCDSPI_send_cmd(&spi, 0x1);
	delay_ms(150);

}


